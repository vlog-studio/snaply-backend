        "kind": "hardcut"
      },
      "outgoing": {
        "cutMs": 100,
        "spareAfterMs": 0
      },
      "incoming": {
        "cutMs": 100,
        "spareBeforeMs": 0
      },
      "expected": {
        "kind": "hardcut"
      }
    },
    {
      "name": "crossfade — 여분이 충분하면 고른 길이 그대로",
