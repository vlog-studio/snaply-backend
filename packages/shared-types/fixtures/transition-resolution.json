        "kind": "crossfade",
        "durationMs": 800
      },
      "outgoing": {
        "cutMs": 2000,
        "spareAfterMs": 500
      },
      "incoming": {
        "cutMs": 2000,
        "spareBeforeMs": 500
      },
      "expected": {
        "kind": "crossfade",
        "durationMs": 800
      }
    },
    {
      "name": "crossfade — 짧은 쪽 여분의 두 배로 줄어든다",
      "transition": {
        "kind": "crossfade",
        "durationMs": 800
      },
      "outgoing": {
        "cutMs": 2000,
        "spareAfterMs": 1000
      },
      "incoming": {
        "cutMs": 2000,
        "spareBeforeMs": 150
