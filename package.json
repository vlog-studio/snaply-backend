{
  "name": "snaply",
  "private": true,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:mobile": "npm run build -w @vlog-studio/shared-types && npm run start -w snaply-app -- --dev-client",
    "verify:mobile": "npm run verify -w snaply-app",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "infra:up": "docker compose --env-file apps/api/.env -f docker-compose.dev.yml up -d",
    "infra:down": "docker compose --env-file apps/api/.env -f docker-compose.dev.yml down",
    "infra:logs": "docker compose --env-file apps/api/.env -f docker-compose.dev.yml logs -f",
    "stack": "docker compose --env-file apps/api/.env up -d --build",
    "stack:up": "docker compose --env-file apps/api/.env up --build api",
    "stack:migrate": "docker compose --env-file apps/api/.env run --rm migrate",
    "stack:down": "docker compose --env-file apps/api/.env down",
    "dev:api": "npm run dev -w apps/api",
    "worker": "cd apps/ai-worker && .venv/bin/python src/worker.py",
    "worker:analysis": "cd apps/ai-worker && .venv/bin/python src/analysis_worker.py",
    "worker:install": "cd apps/ai-worker && python3.11 -m venv .venv && .venv/bin/pip install -r requirements.txt",
    "db:generate": "npm run prisma:generate -w apps/api",
    "db:migrate": "npm run prisma:migrate -w apps/api",
    "db:seed": "npm run seed:locations -w apps/api",
    "db:studio": "npm run prisma:studio -w apps/api",
    "analysis:run": "node scripts/analysis-run.mjs",
    "media:e2e": "node scripts/media-e2e.mjs",
    "media:cleanup": "node scripts/media-cleanup.mjs"
  },
  "devDependencies": {
    "eslint": "^9.30.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0"
  },
  "overrides": {
    "react-native": "0.86.3",
    "@react-native/jest-preset": "0.86.3"
  },
  "allowScripts": {
    "@firebase/util@1.15.1": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "msgpackr-extract@3.0.4": true,
    "prisma@6.19.3": true,
    "protobufjs@7.6.5": true,
    "unrs-resolver@1.12.2": true
  }
}
