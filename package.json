{
  "name": "vlog-studio",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f docker-compose.dev.yml down",
    "infra:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "stack:up": "docker compose up --build api",
    "stack:migrate": "docker compose exec api npx prisma migrate deploy --schema prisma/schema.prisma",
    "stack:down": "docker compose down",
    "dev:api": "npm run dev -w apps/api",
    "worker": "cd apps/ai-worker && .venv/bin/python src/worker.py",
    "worker:install": "cd apps/ai-worker && python3.11 -m venv .venv && .venv/bin/pip install -r requirements.txt",
    "db:generate": "npm run prisma:generate -w apps/api",
    "db:migrate": "npm run prisma:migrate -w apps/api",
    "db:seed": "npm run seed:locations -w apps/api",
    "db:studio": "npm run prisma:studio -w apps/api",
    "media:e2e": "node scripts/media-e2e.mjs",
    "media:cleanup": "node scripts/media-cleanup.mjs"
  },
  "devDependencies": {
    "eslint": "^9.30.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0"
  }
}
