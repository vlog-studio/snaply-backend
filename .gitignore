# deps
node_modules/
.turbo/

# build
dist/
*.tsbuildinfo

# env
.env
.env.*
!.env.example

# 크리덴셜 — 절대 커밋 금지
# Firebase 서비스 계정 키 (예: snaply-xxxxx-firebase-adminsdk-xxxxx.json)
*firebase-adminsdk*.json
*service-account*.json
*serviceAccount*.json
*.pem
*.p8
*.p12

# python
__pycache__/
*.pyc
.venv/
venv/

# BGM 음원 (라이선스 음원/개발 placeholder는 git에 커밋하지 않음)
apps/ai-worker/assets/bgm/**/*.m4a
apps/ai-worker/assets/bgm/**/*.mp3
apps/ai-worker/assets/bgm/**/*.aac
apps/ai-worker/assets/bgm/**/*.wav
apps/ai-worker/assets/bgm/**/*.ogg
apps/ai-worker/assets/bgm/**/*.flac

# 스냅 내용 분석 스파이크 — 평가 영상·추출 프레임·리포트는 커밋하지 않는다
# (원본은 팀 촬영분이고 결과 리포트는 재생성 가능하다)
apps/ai-worker/scripts/analysis-spike/samples/
apps/ai-worker/scripts/analysis-spike/out/
apps/ai-worker/scripts/analysis-spike/models.json

