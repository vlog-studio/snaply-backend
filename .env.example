# ── Database (Supabase PostgreSQL) ──────────────────────
# Supabase Dashboard → Settings → Database → Connection string
# DATABASE_URL: pgbouncer(6543) 풀러 경유, DIRECT_URL: 직접 연결(5432, 마이그레이션용)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# ── Supabase ────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # 서버 전용, 클라이언트 노출 금지

# ── S3 스토리지 (개발: MinIO / 운영: AWS S3) ────────────
# 개발은 MinIO(S3 호환)를 사용. 운영 전환 시 S3_ENDPOINT를 비우면 실제 AWS S3로 동작.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=
S3_ENDPOINT=                     # 개발(MinIO): http://localhost:9000 / 운영(AWS S3): 비워둠
CLOUDFRONT_DOMAIN=               # 운영에서만: https://xxxxx.cloudfront.net
# S3_PRESIGN_EXPIRY_SECONDS=900  # presigned URL 만료 (기본 15분)
# S3_MAX_UPLOAD_BYTES=524288000  # 단일 클립 최대 크기 (기본 500MB)

# ── Firebase ────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_KEY=     # 서비스 계정 JSON(base64). 미설정 시 FCM은 dry-run(로그만)

# ── Redis (개발: 로컬 Docker / 운영: Upstash) ───────────
REDIS_URL=                       # 개발: redis://localhost:6379 / 운영: rediss://...

# ── Stripe ──────────────────────────────────────────────
# STRIPE_SECRET_KEY 가 비어 있으면 자동으로 mock 모드로 동작한다.
STRIPE_SECRET_KEY=                # 테스트: sk_test_... / 운영: sk_live_...
STRIPE_WEBHOOK_SECRET=            # `stripe listen` 이 출력하는 whsec_...
STRIPE_PRICE_STANDARD=            # price_... (Standard ₩9,900/월)
STRIPE_PRICE_PREMIUM=             # price_... (Premium ₩24,900/월)
# STRIPE_MOCK=true                # 실키가 있어도 강제로 mock. (SNS_MOCK 과 독립)

# ── Instagram ───────────────────────────────────────────
# "Instagram API with Instagram Login" 기준. 프로페셔널(비즈니스/크리에이터) 계정 필요.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=           # https://api.도메인/sns/instagram/callback
# 웹훅 "인증 토큰" — Meta 콘솔에 입력하는 값과 같아야 한다(우리가 임의로 정함).
# 릴스 게시에는 불필요하지만, 콘솔이 웹훅 등록을 요구할 때 검증 통과용.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# INSTAGRAM_GRAPH_VERSION=v23.0   # graph.instagram.com API 버전
# INSTAGRAM_POLL_INTERVAL_MS=10000  # 릴스 컨테이너 상태 폴링 간격
# INSTAGRAM_POLL_TIMEOUT_MS=300000  # 릴스 컨테이너 처리 대기 한도(5분)

# ── TikTok ──────────────────────────────────────────────
# PULL_FROM_URL 방식이라 영상 URL 의 도메인/URL prefix 소유권 검증이 필요하다.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=              # https://api.도메인/sns/tiktok/callback
# 요청 스코프. 심사 통과 전에는 video.publish 를 쓸 수 없다.
#   video.publish → 직접 게시 (심사 필요)
#   video.upload  → 받은함 초안. 사용자가 틱톡 앱에서 마무리해야 게시됨 (심사 불필요)
# 엔드포인트는 이 값에서 자동 결정된다.
# TIKTOK_SCOPES=user.info.basic,video.publish
# TIKTOK_POLL_INTERVAL_MS=5000    # 게시 상태 폴링 간격
# TIKTOK_POLL_TIMEOUT_MS=120000   # 게시 완료 대기 한도(2분). 초과 시 실패가 아니라 pending

# ── 연동 mock 스위치 ────────────────────────────────────
# SNS_MOCK=true                   # 인스타/틱톡을 강제로 mock (실키가 있어도)

# ── API ─────────────────────────────────────────────────
API_PORT=3000
API_BASE_URL=
SNS_TOKEN_ENCRYPTION_KEY=         # access_token 암호화 키 (32바이트)
# APP_DEEPLINK_SCHEME=snaply://   # OAuth/결제 완료 후 앱으로 돌아가는 스킴
# RATE_LIMIT_GLOBAL_MAX=60        # 전역 IP당 분당 요청 수 (/billing/webhook 은 제외)

# ── AI Worker ───────────────────────────────────────────
AI_WORKER_PORT=8000

# ── Sentry ──────────────────────────────────────────────
SENTRY_DSN=                        # 미설정 시 캡처는 no-op. SENTRY_DEBUG=true 로 전송 로그 확인
