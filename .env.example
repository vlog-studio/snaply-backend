# 이 파일은 **로컬 개발용** 템플릿이다. `cp .env.example apps/api/.env` 로 복사해 쓴다.
# 운영에는 이 파일을 배포하지 않는다 — 값은 배포 플랫폼의 시크릿으로 주입한다.
# (경계와 배경: docs/decisions/env-management.md)
#
# 변수의 단일 원천은 `apps/api/src/env-spec.ts` 다. 여기와 어긋나면 테스트가 실패한다.
#
# ⚠ 설명은 **줄 위**에 쓴다. `KEY=   # 설명` 처럼 빈 값 뒤에 주석을 달면
#   docker compose 의 env_file 파서가 주석 전체를 값으로 읽는다(Node 는 빈 값으로 읽는다).
#   같은 파일을 서버·compose·워커가 함께 읽으므로 이 형식을 지킨다.

# ── Database (Supabase PostgreSQL) ──────────────────────
# Supabase Dashboard → Settings → Database → Connection string
# DATABASE_URL: pgbouncer(6543) 풀러 경유, DIRECT_URL: 직접 연결(5432, 마이그레이션용)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
# 로컬 Postgres(`npm run infra:up`)의 호스트 포트. 비우면 5432.
# 코드가 아니라 docker-compose.dev.yml 이 읽는 유일한 변수다 — 바꾸면 위 두 URL 의 포트도 같이 바꾼다.
# 5433 은 피한다: 스택(docker-compose.yml)의 postgres 가 고정으로 쓰는 포트다.
POSTGRES_HOST_PORT=

# ── Supabase ────────────────────────────────────────────
SUPABASE_URL=
# sb_publishable_... (Swagger 개발 로그인/클라이언트용)
# 대시보드 → 상단 [connect] → Server Build APIs → 2. Set Environment variables
SUPABASE_PUBLISHABLE_KEY=
# 레거시 fallback. 신규 프로젝트는 위 변수를 쓴다.
SUPABASE_ANON_KEY=
# 계정 실삭제 배치(accounts:purge)와 scripts/media-cleanup.mjs 가 사용. 클라이언트 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=
# JWT aud 클레임 (기본값 authenticated)
# SUPABASE_JWT_AUDIENCE=authenticated

# ── S3 스토리지 (개발: MinIO / 운영: AWS S3) ────────────
# 개발은 MinIO(S3 호환)를 사용. 운영 전환 시 S3_ENDPOINT를 비우면 실제 AWS S3로 동작.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=
# 클라이언트가 접근할 MinIO 주소. presigned URL과 영상/썸네일 공개 URL에 사용.
# 예: http://192.168.0.10:9100 / 운영(AWS S3): 비워둠
S3_PUBLIC_ENDPOINT=
# 개발(MinIO): http://localhost:9100 / 운영(AWS S3): 비워둠
S3_ENDPOINT=
# 운영에서만: https://xxxxx.cloudfront.net
CLOUDFRONT_DOMAIN=
# presigned URL 만료 (기본 15분)
# S3_PRESIGN_EXPIRY_SECONDS=900
# 영상/썸네일 재생 URL 만료 (기본 1시간)
# S3_DOWNLOAD_URL_EXPIRY_SECONDS=3600
# 단일 클립 최대 크기 (기본 500MB)
# S3_MAX_UPLOAD_BYTES=524288000

# ── Firebase ────────────────────────────────────────────
FIREBASE_PROJECT_ID=
# 서비스 계정 JSON(base64). 미설정 시 FCM은 dry-run(로그만).
FIREBASE_SERVICE_ACCOUNT_KEY=

# ── Redis (개발: 로컬 Docker / 운영: Upstash) ───────────
# 개발: redis://localhost:6379 / 운영: rediss://...
REDIS_URL=
# 편집 큐 이름. API 와 워커가 같은 값이어야 한다.
# EDIT_QUEUE_NAME=edit-jobs
# 스냅 분석 큐 이름. API 와 분석 워커가 같은 값이어야 한다.
# VIDEO_ANALYSIS_QUEUE_NAME=video-analysis

# ── 스냅 내용 분석 (분석 워커 전용) ─────────────────────
# 분석 결과는 자동 편집 추천의 입력이며 사용자에게 노출하지 않는다.
# docs/decisions/snap-content-analysis.md
# vision 분석 키. 분석 워커만 소비한다 — 없으면 분석 워커가 기동 단계에서 실패한다.
# (API 서버는 이 값을 읽지 않으므로 비어 있어도 API 는 정상 기동한다.)
OPENAI_API_KEY=
# 분석 모델. 운영 모델을 고정할 때 이 값을 바꾼다.
# OPENAI_VISION_MODEL=gpt-5.6-luna
# 프레임 업로드 해상도 모드.
# OPENAI_IMAGE_DETAIL=low
# 분석 1건 타임아웃(초).
# VIDEO_ANALYSIS_TIMEOUT_SECONDS=90
# 분석 워커 동시 처리 수.
# VIDEO_ANALYSIS_CONCURRENCY=3
# 결과에 기록되는 프롬프트 버전 태그. 프롬프트를 바꾸면 올린다.
# VIDEO_ANALYSIS_PROMPT_VERSION=v1

# ── 템플릿 스냅 추천 ────────────────────────────────────
# true 일 때만 POST /movie-recommendations 가 동작한다. 이 경로는 후보 스냅의 프레임을 외부
# 모델 제공자로 보내는 분석을 호출하므로, 약관 개정·제3자 제공 고지가 끝나기 전에는 켜지 않는다.
# 꺼져 있으면 앱은 로컬 매칭만으로 템플릿 화면을 채운다.
# MOVIE_RECOMMENDATION_ENABLED=false

# ── 결제 (RevenueCat + Apple/Google IAP) ────────────────
# 크레딧 팩은 앱 내 인앱결제로만 판매한다. 두 스토어의 영수증 검증·통지는 RevenueCat 경유.
# REVENUECAT_API_KEY 가 비어 있으면 자동으로 mock 모드로 동작한다(웹훅 인증은 그대로 검증).
# REST 시크릿 키 (POST /billing/sync 의 구매 이력 조회용)
REVENUECAT_API_KEY=
# 웹훅 Authorization 헤더 검증 값. RevenueCat 대시보드에 같은 값을 등록한다(우리가 임의로 정함).
REVENUECAT_WEBHOOK_AUTH_TOKEN=
# 실키가 있어도 강제로 mock. (SNS_MOCK 과 독립)
# BILLING_MOCK=true
# 신규 가입 지급 크레딧. 수량 미확정이라 기본 0(지급 안 함) — docs/backlog.md A-2.
# 로컬에서 결제 없이 export 를 돌리려면 100 이상으로 둔다 (100크레딧 = Movie 1편).
# CREDIT_SIGNUP_BONUS=1000

# ── 보상형 광고 (AdMob SSV) ─────────────────────────────
# 지급의 유일한 트리거는 AdMob 의 SSV 콜백이다 — 앱이 지급을 요청하는 경로는 없다.
# docs/decisions/ad-reward-credits.md
# 킬 스위치. true 여야 세션이 발급된다. AdMob 콘솔 설정(광고 단위 · SSV 콜백 URL) 전에는 꺼 둔다.
# AD_REWARD_ENABLED=true
# 광고 1편 완료당 지급 크레딧 (기본 20, 확정값 — docs/decisions/ad-reward-credits.md §7)
# AD_REWARD_CREDITS=20
# KST 하루 최대 지급 횟수 (기본 5, 확정값). 20 × 5 = 100 = export 1편이다.
# AD_REWARD_DAILY_LIMIT=5
# 마지막 지급 이후 다음 세션까지의 대기 시간 (기본 300, 확정값).
# 세션 TTL 보다 작게 두지 않는다 — 아래 TTL 주석의 역전이 생긴다.
# AD_REWARD_COOLDOWN_SECONDS=300
# 세션 만료. SSV 가 이 시간 뒤에 도착하면 지급하지 않는다 (기본 300).
# 쿨다운보다 크게 잡지 않는다 — 콜백이 유실된 사용자가 지급받은 사용자보다 오래 잠긴다.
# AD_REWARD_SESSION_TTL_SECONDS=300
# SSV 를 받아들일 광고 단위 ID(쉼표 구분). 비어 있으면 전부 거절한다.
ADMOB_SSV_ALLOWED_AD_UNITS=
# 서명 검증 공개키 세트. 기본 gstatic 이며 보통 비워 둔다.
# ADMOB_VERIFIER_KEYS_URL=https://www.gstatic.com/admob/reward/verifier-keys.json

# ── Instagram ───────────────────────────────────────────
# "Instagram API with Instagram Login" 기준. 프로페셔널(비즈니스/크리에이터) 계정 필요.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# https://api.도메인/sns/instagram/callback
INSTAGRAM_REDIRECT_URI=
# 웹훅 "인증 토큰" — Meta 콘솔에 입력하는 값과 같아야 한다(우리가 임의로 정함).
# 릴스 게시에는 불필요하지만, 콘솔이 웹훅 등록을 요구할 때 검증 통과용.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# graph.instagram.com API 버전
# INSTAGRAM_GRAPH_VERSION=v23.0
# 릴스 컨테이너 상태 폴링 간격 / 처리 대기 한도(5분)
# INSTAGRAM_POLL_INTERVAL_MS=10000
# INSTAGRAM_POLL_TIMEOUT_MS=300000

# ── TikTok ──────────────────────────────────────────────
# PULL_FROM_URL 방식이라 영상 URL 의 도메인/URL prefix 소유권 검증이 필요하다.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# https://api.도메인/sns/tiktok/callback
TIKTOK_REDIRECT_URI=
# 요청 스코프. 심사 통과 전에는 video.publish 를 쓸 수 없다.
#   video.publish → 직접 게시 (심사 필요)
#   video.upload  → 받은함 초안. 사용자가 틱톡 앱에서 마무리해야 게시됨 (심사 불필요)
# 엔드포인트는 이 값에서 자동 결정된다.
# TIKTOK_SCOPES=user.info.basic,video.publish
# 게시 상태 폴링 간격 / 완료 대기 한도(2분). 초과 시 실패가 아니라 pending.
# TIKTOK_POLL_INTERVAL_MS=5000
# TIKTOK_POLL_TIMEOUT_MS=120000

# ── 연동 mock 스위치 ────────────────────────────────────
# 인스타/틱톡을 강제로 mock (실키가 있어도)
# SNS_MOCK=true

# ── API ─────────────────────────────────────────────────
# Swagger 와 개발 로그인은 NODE_ENV=development 일 때만 열린다.
# 값이 없거나 오타면 닫힌 채로 뜬다 — 운영에서 안전한 쪽으로 떨어지도록 의도한 것이다.
NODE_ENV=development
# 로컬에서 3000이 점유됐다면 이 값만 바꾸면 됨 (예: 3002)
API_PORT=3000
# scripts/media-e2e.mjs 가 찌를 주소. 기본 http://localhost:$API_PORT
API_BASE_URL=
# bind 주소
# API_HOST=0.0.0.0
# 운영에서도 Swagger 를 열 때만. 개발 로그인은 그래도 닫힌다.
# ENABLE_DOCS=true
# Fastify 로그 레벨
# LOG_LEVEL=info
# SNS access_token 암호화 키 (32바이트)
SNS_TOKEN_ENCRYPTION_KEY=
# OAuth/결제 완료 후 앱으로 돌아가는 스킴
# APP_DEEPLINK_SCHEME=snaply://
# 전역 IP당 분당 요청 수 (/billing/webhook 은 제외)
# RATE_LIMIT_GLOBAL_MAX=60

# ── AI Worker ───────────────────────────────────────────
AI_WORKER_PORT=8000
# faster-whisper 모델 크기
# WHISPER_MODEL=small
# 편집 작업 1건의 타임아웃
# EDIT_TIMEOUT_SECONDS=1800
# BGM 음원 디렉터리. 컨테이너는 Dockerfile 에서 주입한다.
# BGM_DIR=

# ── 공개 페이지 (플랫폼 콘솔이 요구하는 서비스/약관/개인정보 URL) ──
# 약관·개인정보처리방침 페이지에 표시되는 문의처
LEGAL_CONTACT_EMAIL=

# ── 플랫폼 URL 소유권 검증 ──────────────────────────────
# 틱톡은 약관/개인정보 URL 을 "verified" 상태로 만들라고 요구한다(저장 단계에서도).
# 개발 터널 도메인은 우리 소유가 아니라 DNS TXT 방식은 불가 → 아래 두 방식만 쓸 수 있다.
#
# 메타 태그 방식: 서빙하는 페이지 <head> 에 삽입된다. `name=content`, 콤마로 여러 개.
# 예: tiktok-developers-site-verification=abc123
SITE_VERIFICATION_META=
# 파일 방식: 지정한 파일명을 루트에서 평문으로 서빙한다.
# 예: tiktokAbc123.txt
SITE_VERIFICATION_FILE_NAME=
# 위 파일에 들어갈 문자열
SITE_VERIFICATION_FILE_CONTENT=

# ── Sentry ──────────────────────────────────────────────
# 미설정 시 캡처는 no-op. API·워커 공통.
SENTRY_DSN=
# 전송 로그를 남긴다
# SENTRY_DEBUG=true

# ── 로컬 e2e 스크립트 (npm run media:e2e / media:cleanup) ──
# e2e 가 로그인할 계정
TEST_EMAIL=
TEST_PASSWORD=
