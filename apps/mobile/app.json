{
  "expo": {
    "name": "Snaply",
    "slug": "snaply-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "snaplyapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.anonymous.snaplyapp",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#16110D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.snaplyapp",
      "googleServicesFile": "./google-services.json",
      "permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Snaply가 영상을 촬영할 수 있도록 카메라 접근을 허용해 주세요.",
          "microphonePermission": "Snaply가 영상에 소리를 녹음할 수 있도록 마이크 접근을 허용해 주세요.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF4EC",
          "image": "./assets/images/brand-glyph-ember.png",
          "imageWidth": 150,
          "dark": {
            "backgroundColor": "#16110D",
            "image": "./assets/images/brand-glyph-ember.png"
          }
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Pretendard GOV",
                "fontDefinitions": [
                  { "path": "./assets/fonts/PretendardGOV-Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/PretendardGOV-Medium.ttf", "weight": 500 },
                  { "path": "./assets/fonts/PretendardGOV-Bold.ttf", "weight": 700 },
                  { "path": "./assets/fonts/PretendardGOV-ExtraBold.ttf", "weight": 800 }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/PretendardGOV-Regular.ttf",
              "./assets/fonts/PretendardGOV-Medium.ttf",
              "./assets/fonts/PretendardGOV-Bold.ttf",
              "./assets/fonts/PretendardGOV-ExtraBold.ttf"
            ]
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "찍은 스냅이 어디에서 촬영됐는지 기록해 같은 장소의 스냅을 한 편으로 묶고, 주변 촬영 스팟을 추천해 드리기 위해 위치 접근이 필요해요.",
          "locationAlwaysAndWhenInUsePermission": "앱을 보고 있지 않아도 주변 스팟에 도착하면 알림을 보내드리기 위해 '항상 허용' 위치 권한이 필요해요.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      "expo-video",
      "expo-sharing",
      "expo-secure-store",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4341953141795570~1619593560"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "./plugins/with-gradle-jvmargs.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
