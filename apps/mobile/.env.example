# Supabase — copy to .env and fill in from your Supabase project settings
# (Project Settings → API). Both values are client-safe: the anon key is a
# public credential gated server-side by Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Backend API origin (e.g. http://192.168.0.58:3000 for a local backend, or
# the dev-server URL once one exists). Leave blank to run against in-code
# mocks. Also used by `npm run api:pull` to refresh docs/api/openapi.json
# from <origin>/docs/json.
EXPO_PUBLIC_API_BASE_URL=
# Force mock mode even when a base URL is set — useful when the backend is
# unreachable or when developing against the in-code mocks.
EXPO_PUBLIC_USE_MOCK_API=

# AdMob rewarded ad units, per platform (the App IDs live in app.json, since
# they are baked into the native manifest). Leave a platform blank until its
# AdMob app and rewarded unit exist — the app then reports "no ad to show"
# instead of asking for a unit that is not there.
EXPO_PUBLIC_ADMOB_REWARDED_AD_UNIT_ID_ANDROID=
EXPO_PUBLIC_ADMOB_REWARDED_AD_UNIT_ID_IOS=

# Devices allowed to receive test ads from the units above. Required for any
# development run that should actually earn a credit: server-side verification
# is configured per ad unit, so Google's public test unit never calls back and
# the reward stays `pending` forever. A registered device gets test ads from
# our own unit, which does call back.
#
# The id is per device and per install — the ads SDK logs it on the first ad
# request ("Use RequestConfiguration.Builder().setTestDeviceIds(...)"), so it
# belongs in your own .env, not here. Comma-separated; use EMULATOR for one.
# Leave blank in release builds.
EXPO_PUBLIC_ADMOB_TEST_DEVICE_IDS=
