{
  "name": "@vlog-studio/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run && tsc -p tsconfig.json && node --test test/storage.service.test.mjs",
    "test:watch": "vitest",
    "auth:stub": "tsx scripts/auth-stub.ts",
    "accounts:purge": "node --env-file=.env --import tsx scripts/purge-deleted-accounts.ts",
    "dev:public-bucket": "node --env-file=.env --import tsx scripts/dev-public-bucket.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed:locations": "node --env-file=.env prisma/seeds/seed-locations.mjs",
    "ig:probe": "node --env-file=.env --import tsx scripts/ig-token-probe.ts",
    "ig:publish-probe": "node --env-file=.env --import tsx scripts/ig-publish-probe.ts",
    "ig:container-probe": "node --env-file=.env --import tsx scripts/ig-container-probe.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@aws-sdk/s3-request-presigner": "^3.1092.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.2.0",
    "@fastify/websocket": "^8.3.1",
    "@prisma/client": "^6.10.1",
    "@sentry/node": "^8.55.2",
    "@vlog-studio/shared-types": "*",
    "bullmq": "^5.80.10",
    "fastify": "^4.29.1",
    "fastify-plugin": "^4.5.1",
    "firebase-admin": "^12.7.0",
    "ioredis": "^5.11.1",
    "jose": "^5.10.0",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "prisma": "^6.10.1",
    "tsx": "^4.20.3",
    "vitest": "^4.1.10"
  }
}
