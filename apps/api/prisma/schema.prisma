// Snaply (vlog-studio) 백엔드 DB 스키마
// Supabase PostgreSQL 기준. RLS 정책은 prisma/rls-policies.sql로 별도 적용.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Supabase Auth(auth.users)와 연동되는 앱 유저 테이블
model User {
  id                  String    @id @default(uuid()) @db.Uuid
  supabaseUid         String    @unique @map("supabase_uid") @db.Uuid
  nickname            String?   @db.VarChar(50)
  avatarUrl           String?   @map("avatar_url")
  fcmToken            String?   @map("fcm_token")
  interests           String[]  @default([])
  notificationEnabled Boolean   @default(true) @map("notification_enabled")
  quietStart          Int       @default(22) @map("quiet_start")
  quietEnd            Int       @default(8) @map("quiet_end")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  // 계정 삭제 요청 시각. 30일 유예 후 purge 배치가 실삭제한다 (docs/decisions/account-deletion.md)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  notificationLogs NotificationLog[]
  videos           Video[]
  editJobs         EditJob[]
  videoAnalyses    VideoAnalysis[]
  snsConnections   SnsConnection[]
  snsUploads       SnsUpload[]
  purchases        Purchase[]
  creditEntries    CreditLedger[]
  adRewards        AdReward[]
  recommendations  MovieRecommendation[]
  movies           Movie[]

  @@index([deletedAt])
  @@map("users")
}

// Geofence 포인트 DB
model Location {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(100)
  lat             Float
  lng             Float
  radiusMeters    Int      @default(500) @map("radius_meters")
  messageTemplate String?  @map("message_template")
  category        String?  @db.VarChar(50)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  notificationLogs NotificationLog[]

  @@map("locations")
}

// 알림 쿨다운 관리 (30분 중복 방지)
model NotificationLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  sentAt     DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([userId, locationId, sentAt])
  @@map("notification_logs")
}

// 영상 원본 및 편집 결과
enum VideoKind {
  source
  result
}

/// 영상이 사라진 이유. 사용자에게 보일 문구와 안내 톤이 다르므로 구분해 저장한다
/// (docs/specs/snap-library.md SNAP-12). `deleted_at` 이 있는데 이 값이 없는 행은
/// 이 컬럼이 생기기 전에 지워진 것이며 `user` 로 읽는다.
enum VideoRemovalReason {
  /// 사용자가 직접 지웠다.
  user
  /// 보관 기간이 지나 우리 정책으로 사라졌다.
  expired
}

model Video {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  kind            VideoKind @default(source)
  originalUrls    String[]  @default([]) @map("original_urls")
  originalS3Keys  String[]  @default([]) @map("original_s3_keys")
  editedUrl       String?   @map("edited_url")
  editedS3Key     String?   @map("edited_s3_key")
  thumbnailUrl    String?   @map("thumbnail_url")
  thumbnailS3Key  String?   @map("thumbnail_s3_key")
  durationSeconds Int?      @map("duration_seconds")
  stylePreset     String?   @map("style_preset") @db.VarChar(20)
  status          String    @default("pending") @db.VarChar(20)
  s3Key           String?   @map("s3_key")
  /// 클라이언트가 보고한 촬영 시각. 서버가 소급할 수 없어, 전달 이전에 올라온 행은 null 로 남는다.
  capturedAt      DateTime? @map("captured_at") @db.Timestamptz(6)
  /// 어디서나 재생되는 배포본(H.264/SDR)의 S3 키. 원본은 아이폰 HEVC/HDR 그대로라
  /// 다른 플랫폼에서 재생되지 않을 수 있어, ingest 워커가 따로 만든다.
  /// 원본은 지우지 않는다 — 편집은 계속 원본을 쓴다.
  renditionS3Key  String?   @map("rendition_s3_key")
  /// 렌디션 생성 상태: pending | processing | ready | failed. 실패해도 스냅 자체는 쓸 수 있다.
  renditionStatus String    @default("pending") @map("rendition_status") @db.VarChar(20)
  /// FFprobe 로 실측한 길이. 클라이언트가 보고한 durationSeconds 보다 정확하다.
  durationMs      Int?      @map("duration_ms")
  /// 왜 사라졌는가. 행은 툼스톤으로 남으므로(SNAP-12) 사용자는 무엇을 잃었는지 알 수 있다.
  removalReason   VideoRemovalReason? @map("removal_reason")
  /// 파일을 실제로 지운 시각. 만료 "예정"이 아니라 일어난 사실이다 — 만료 판정 자체는
  /// 저장하지 않고 업로드 시각 + 정책 값으로 유도한다(services/retention-policy.ts).
  purgedAt        DateTime? @map("purged_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  editJobs   EditJob[]
  snsUploads SnsUpload[]
  analyses   VideoAnalysis[]
  recommendationItems MovieRecommendationItem[]
  movieClips MovieClip[]
  resultOf   Movie[]         @relation("MovieResult")

  @@index([userId, createdAt])
  @@index([userId, kind, createdAt])
  /// ingest 워커가 밀린 것을 찾을 때 쓴다.
  @@index([renditionStatus])
  @@map("videos")
}

// AI 편집 작업 상태 추적
model EditJob {
  id              String    @id @default(uuid()) @db.Uuid
  videoId         String    @map("video_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  pipelineVersion String    @default("2") @map("pipeline_version") @db.VarChar(20)
  editSpec        Json      @default("{}") @map("edit_spec")
  renderSpec      Json      @default("{}") @map("render_spec")
  status          String    @default("queued") @db.VarChar(20)
  progress        Int       @default(0)
  errorMessage    String?   @map("error_message")
  errorCode       String?   @map("error_code") @db.VarChar(40)
  startedAt       DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("edit_jobs")
}

// 스냅 내용 분석 — AI 워커가 대표 프레임을 vision 모델에 보내 얻은 결과.
// 결과는 자동 편집 추천의 입력이며 사용자에게 노출하지 않는다.
// 결정: docs/decisions/snap-content-analysis.md
model VideoAnalysis {
  id              String @id @default(uuid()) @db.Uuid
  videoId         String @map("video_id") @db.Uuid
  userId          String @map("user_id") @db.Uuid
  // 모델·프롬프트가 바뀌었을 때 기존 결과를 덮지 않고 새 버전으로 비교하기 위한 값.
  analysisVersion Int    @default(1) @map("analysis_version")
  status          String @default("queued") @db.VarChar(20)

  // 이 분석이 사용한 FFprobe 실측값의 스냅샷. 길이의 원천은 videos 쪽이다.
  durationMs        Int?  @map("duration_ms")
  frameTimestampsMs Int[] @default([]) @map("frame_timestamps_ms")

  summary String?
  topics  String[] @default([])
  places  String[] @default([])
  objects String[] @default([])
  actions String[] @default([])
  moods   String[] @default([])

  visualQualityScore Float?   @map("visual_quality_score")
  visualIssues       String[] @default([]) @map("visual_issues")
  usableForEdit      Boolean? @map("usable_for_edit")
  confidence         Float?

  provider String  @default("openai") @db.VarChar(30)
  // 레코드는 워커가 모델을 고르기 전에 만들어지므로 완료 시점에 채워진다.
  modelVersion  String? @map("model_version") @db.VarChar(100)
  promptVersion String? @map("prompt_version") @db.VarChar(30)

  inputTokens  Int?    @map("input_tokens")
  outputTokens Int?    @map("output_tokens")
  attempts     Int     @default(0)
  errorCode    String? @map("error_code") @db.VarChar(40)
  errorMessage String? @map("error_message")

  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([videoId, analysisVersion])
  @@index([userId, status])
  @@index([status, createdAt])
  @@map("video_analyses")
}

// 무비 템플릿 카탈로그 — 사용자가 "템플릿으로 시작"할 때 고르는 무비의 형태.
//
// 앱의 로컬 상수에서 서버로 옮겼다. 슬롯의 매칭 규칙(match_hints)과 슬롯 정의가 서로 다른
// 저장소에 있으면 한쪽만 고쳐진다 — docs/decisions/template-snap-recommendation.md §2.
//
// 유저 데이터가 아니라 제품 데이터다. 그래서 user_id 가 없고, 행은 마이그레이션이 넣는다.
model MovieTemplate {
  // 'walk' · 'cafe' 처럼 사람이 읽는 고정 id. 앱의 내장 폴백 카탈로그와 같은 값이어야
  // 서버 응답과 폴백이 같은 템플릿을 가리킨다.
  id          String @id @db.VarChar(40)
  name        String @db.VarChar(60)
  description String @db.VarChar(120)
  // POST /edit-jobs 가 받는 프리셋 이름 그대로('감성'·'여행'·'일상'). 앱 쪽 영문 MovieStyle 로의
  // 변환은 앱이 한다 — 편집 프리셋의 원천은 서버다.
  style String @db.VarChar(20)
  // 앱에서만 쓰는 트랙 키. 서버 편집 파이프라인은 BGM 을 받지 않는다.
  bgm       String @db.VarChar(40)
  sortOrder Int    @map("sort_order")
  // 내린 템플릿. 행을 지우면 그 템플릿으로 만든 과거 추천이 고아가 된다.
  retiredAt DateTime? @map("retired_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  slots MovieTemplateSlot[]
  recommendations MovieRecommendation[]

  @@index([retiredAt, sortOrder])
  @@map("movie_templates")
}

// 템플릿의 한 장면. label·hint 는 사람에게 보여주는 촬영 지시고, matchHints 는 점수화 내부값이다.
model MovieTemplateSlot {
  templateId String @map("template_id") @db.VarChar(40)
  // 템플릿 안에서만 유일하면 되는 id('start'·'menu'). 추천 응답이 슬롯을 가리키는 키다.
  slotId   String @map("slot_id") @db.VarChar(40)
  position Int
  label    String @db.VarChar(30)
  hint     String @db.VarChar(80)
  // { places, objects, actions, topics, temporalPrior } — 추천 점수화가 읽는 값이며
  // GET /movie-templates 응답에는 넣지 않는다. jsonb 라 형태가 바뀌어도 마이그레이션이 필요없다.
  matchHints Json @default("{}") @map("match_hints")

  template MovieTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([templateId, slotId])
  @@unique([templateId, position])
  @@map("movie_template_slots")
}

// 템플릿 슬롯에 어떤 스냅을 넣을지에 대한 서버의 제안 1건.
//
// 앱의 로컬 매칭이 먼저 화면을 채우고, 이 결과가 도착하면 그 위에 얹힌다 — 그래서 이 행이
// 늦거나 비어도 사용자는 아무것도 잃지 않는다
// (docs/decisions/template-snap-recommendation.md §1).
model MovieRecommendation {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @map("user_id") @db.Uuid
  templateId String @map("template_id") @db.VarChar(40)
  // 후보 스냅, **촬영 시간 오름차순**. 이 순서가 점수화의 시간 사전값이므로 집합이 아니라
  // 배열로 남긴다. 후보를 고르는 쪽은 앱이다 — 서버는 촬영 시각도 좌표도 모른다.
  candidateVideoIds String[] @map("candidate_video_ids") @db.Uuid
  // (userId, templateId, 후보 집합) 의 해시. 재사용 창 안에서 같은 요청은 같은 추천을 받는다.
  // 화면을 다시 열 때마다 재분석하면 그게 그대로 비용이다.
  candidateHash String @map("candidate_hash") @db.VarChar(64)
  status        String @default("processing") @db.VarChar(20)
  // [{ videoId, reason }] — 배정에서 빠진 후보와 그 이유(unusable · analysis_failed · no_match).
  excluded Json @default("[]")

  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  items    MovieRecommendationItem[]
  user     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template MovieTemplate            @relation(fields: [templateId], references: [id], onDelete: Restrict)

  // 멱등 조회: 같은 후보 집합의 최근 추천을 찾는다.
  @@index([userId, templateId, candidateHash, createdAt])
  // 일일 추천 횟수 집계.
  @@index([userId, createdAt])
  @@map("movie_recommendations")
}

// 슬롯 하나에 대한 배정. `videoId` 가 null 이면 채울 후보가 없었다는 뜻이고, 그 자리는
// 화면에서 `지금 찍기` 로 남는다 — 못 쓸 스냅을 채우는 것보다 정직하다.
model MovieRecommendationItem {
  recommendationId String @map("recommendation_id") @db.Uuid
  slotId           String @map("slot_id") @db.VarChar(40)
  position         Int
  // 영상이 삭제되면 그 자리는 비워진다(SetNull). 추천 전체를 지우지는 않는다.
  videoId String? @map("video_id") @db.Uuid
  score   Float?

  recommendation MovieRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  video          Video?              @relation(fields: [videoId], references: [id], onDelete: SetNull)

  @@id([recommendationId, slotId])
  @@map("movie_recommendation_items")
}

// SNS 연동 계정
model SnsConnection {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  platform         String    @db.VarChar(20)
  platformUserId   String?   @map("platform_user_id") @db.VarChar(100)
  platformUsername String?   @map("platform_username") @db.VarChar(100)
  accessToken      String?   @map("access_token")
  refreshToken     String?   @map("refresh_token")
  tokenExpiresAt   DateTime? @map("token_expires_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@map("sns_connections")
}

// SNS 업로드 이력
model SnsUpload {
  id             String    @id @default(uuid()) @db.Uuid
  videoId        String    @map("video_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  platform       String    @db.VarChar(20)
  platformPostId String?   @map("platform_post_id") @db.VarChar(100)
  status         String    @default("pending") @db.VarChar(20)
  /// 실패 시 플랫폼이 준 사유. 운영에서 업로드 실패를 추적할 유일한 단서다.
  errorMessage   String?   @map("error_message")
  uploadedAt     DateTime? @map("uploaded_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("sns_uploads")
}

// 크레딧 판매 채널. 정기 구독은 제품 모델에 없다 —
// docs/decisions/credit-payment-model.md · docs/decisions/payment-channel-iap.md
enum Store {
  apple
  google
}

/// 스토어 거래 원장. 웹훅 멱등성의 기준이며, 크레딧 지급 사유의 근거가 된다.
model Purchase {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  store              Store
  productId          String    @map("product_id") @db.VarChar(100)
  /// 스토어 트랜잭션 ID. unique 제약이 재전송 웹훅의 중복 지급을 원천 차단한다.
  storeTransactionId String    @unique @map("store_transaction_id") @db.VarChar(200)
  status             String    @default("completed") @db.VarChar(20) // completed | refunded
  creditsGranted     Int       @map("credits_granted")
  environment        String    @default("production") @db.VarChar(20) // production | sandbox
  purchasedAt        DateTime  @map("purchased_at") @db.Timestamptz(6)
  refundedAt         DateTime? @map("refunded_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditEntries CreditLedger[]

  @@index([userId, createdAt])
  @@map("purchases")
}

/// 보상형 광고 세션. 지급의 트리거는 **오직 AdMob SSV 콜백**이며, 앱이 "광고를 봤다"고
/// 알리는 경로는 존재하지 않는다 (docs/decisions/ad-reward-credits.md §3).
/// 이 표는 그 콜백을 우리 사용자·정책과 이어 붙이기 위한 왕복 상태다.
model AdReward {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  /// SSV custom_data 로 왕복하는 일회성 난수. 추측 불가해야 한다.
  nonce         String    @unique @db.VarChar(64)
  /// pending | granted | expired | rejected
  status        String    @db.VarChar(16)
  /// 지급 확정된 크레딧. 세션 발급 시점의 정책값을 스냅샷한다 —
  /// 정책이 바뀌어도 이미 시작된 광고의 약속은 지켜야 한다.
  credits       Int
  /// AdMob transaction_id. 같은 트랜잭션의 재전송이 두 번 지급하지 않는 근거.
  transactionId String?   @unique @map("transaction_id") @db.VarChar(64)
  adUnit        String?   @map("ad_unit") @db.VarChar(64)
  /// 거절 사유(서명 불일치, 한도 초과, 만료 등). 운영 진단용.
  rejectReason  String?   @map("reject_reason") @db.VarChar(64)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  grantedAt     DateTime? @map("granted_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditEntries CreditLedger[]

  @@index([userId, createdAt])
  /// 일일 한도·쿨다운은 "지급된 시각"으로 센다 — 발급만 되고 끝난 세션은 한도를 깎지 않는다.
  @@index([userId, grantedAt])
  @@map("ad_rewards")
}

/// 크레딧 증감 원장. append-only 이며 잔액은 항상 delta 합계다 — 이 표가 잔액의 원천이고
/// 클라이언트·RevenueCat 상태는 표시·동기화용이다 (payment-channel-iap.md §5).
model CreditLedger {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  /// +지급 / -차감. 단위는 100크레딧 = Movie export 1회 (credit-policy.ts)
  delta      Int
  /// purchase | signup_bonus | export_reserve | export_refund | store_refund_revoke | promo | ad_reward
  reason     String   @db.VarChar(30)
  purchaseId String?  @map("purchase_id") @db.Uuid
  editJobId  String?  @map("edit_job_id") @db.Uuid
  adRewardId String?  @map("ad_reward_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchase  Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  adReward  AdReward? @relation(fields: [adRewardId], references: [id], onDelete: SetNull)

  /// 한 작업의 같은 사유는 한 번뿐이다. 예약·환급이 어느 경로로 몇 번 시도되든
  /// (API 취소 / 워커 실패 / 재시도) 결과가 같아지는 근거다. editJobId 가 NULL 인
  /// 행(구매·프로모션)은 Postgres 가 NULL 을 서로 다르게 보므로 제약을 받지 않는다.
  @@unique([editJobId, reason])
  /// 위와 같은 장치. 한 보상 세션은 `ad_reward` 행을 최대 하나만 만든다 — SSV 재전송이
  /// transaction_id unique 를 비껴가더라도 여기서 두 번째 지급이 막힌다.
  @@unique([adRewardId, reason])
  @@index([userId, createdAt])
  @@map("credit_ledger")
}

/// 무비의 생애. 앱의 `MovieStatus` 와 같은 값이며, `generating` 은 진행 중인 EditJob 이 있는 상태다.
enum MovieStatus {
  draft
  generating
  ready
  failed
}

/// 컷 순서를 누가 정했는가. `user` 면 서버가 다시 정렬하지 않는다.
/// 촬영 시각 정렬(movie-export-policy ①)은 `ai` 일 때만 적용된다.
enum MovieArranger {
  user
  ai
}

/// 무비(회의 용어의 "프로젝트") — 스냅을 참조하는 편집 레시피.
///
/// 스냅(`Video`)을 소유하지 않고 참조만 하므로 한 스냅을 여러 무비가 다르게 쓸 수 있다
/// (decisions/movie-model.md). 결과물 파일은 사용자가 "끝내면" 사라지지만 이 레시피는 남아
/// 다시 편집·생성할 수 있다(decisions/movie-cleanup-after-export.md).
model Movie {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  title       String        @db.VarChar(100)
  status      MovieStatus   @default(draft)
  stylePreset String        @default("일상") @map("style_preset") @db.VarChar(20)
  /// 소프트 자막 생성 여부. 기본 꺼짐(쇼츠용).
  captions    Boolean       @default(false)
  /// 현재는 9:16 뿐이지만, 다른 비율이 생겨도 기존 무비가 자기 비율을 지키도록 저장한다.
  ratio       String        @default("9:16") @db.VarChar(10)
  arranger    MovieArranger @default(user)

  /// 살아 있는 결과물 하나(movie-export-policy ②: 누적이 아니라 교체).
  /// 끝내기(MOV-17)나 30일 상한(MOV-16)으로 파일이 사라지면 NULL 로 돌아간다.
  resultVideoId String? @map("result_video_id") @db.Uuid
  /// 사용자가 다운로드·게시로 "끝낸" 시각. 결과물 파일 삭제의 근거이며,
  /// 이 값이 있어도 무비 자체는 계속 편집할 수 있다(MOV-4).
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  resultVideo Video?      @relation("MovieResult", fields: [resultVideoId], references: [id], onDelete: SetNull)
  clips       MovieClip[]

  /// 스튜디오 보드가 최근 수정순으로 읽는다.
  @@index([userId, updatedAt])
  @@map("movies")
}

/// 무비 안의 컷 하나 — 어떤 스냅을, 어느 구간으로, 몇 번째에 쓰는지.
///
/// 스냅을 지워도(또는 15일 만료로 사라져도) 이 행은 남는다: 참조 대상인 `Video` 가 툼스톤으로
/// 남기 때문이며(SNAP-12), 그래서 컷 하나가 만료돼도 무비는 열린다.
model MovieClip {
  id      String @id @default(uuid()) @db.Uuid
  movieId String @map("movie_id") @db.Uuid
  videoId String @map("video_id") @db.Uuid
  /// 0부터의 표시 순서. 같은 무비 안에서 유일하다.
  order   Int
  /// 트림 구간(밀리초). 없으면 스냅 전체를 쓴다.
  startMs Int? @map("start_ms")
  endMs   Int? @map("end_ms")

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([movieId, order])
  @@index([videoId])
  @@map("movie_clips")
}
