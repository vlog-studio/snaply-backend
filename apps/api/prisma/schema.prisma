// Snaply (vlog-studio) 백엔드 DB 스키마
// Supabase PostgreSQL 기준. RLS 정책은 prisma/rls-policies.sql로 별도 적용.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Supabase Auth(auth.users)와 연동되는 앱 유저 테이블
model User {
  id                  String    @id @default(uuid()) @db.Uuid
  supabaseUid         String    @unique @map("supabase_uid") @db.Uuid
  nickname            String?   @db.VarChar(50)
  avatarUrl           String?   @map("avatar_url")
  fcmToken            String?   @map("fcm_token")
  interests           String[]  @default([])
  notificationEnabled Boolean   @default(true) @map("notification_enabled")
  quietStart          Int       @default(22) @map("quiet_start")
  quietEnd            Int       @default(8) @map("quiet_end")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  // 계정 삭제 요청 시각. 30일 유예 후 purge 배치가 실삭제한다 (docs/decisions/account-deletion.md)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  notificationLogs NotificationLog[]
  videos           Video[]
  editJobs         EditJob[]
  snsConnections   SnsConnection[]
  snsUploads       SnsUpload[]
  subscription     Subscription?

  @@index([deletedAt])
  @@map("users")
}

// Geofence 포인트 DB
model Location {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(100)
  lat             Float
  lng             Float
  radiusMeters    Int      @default(500) @map("radius_meters")
  messageTemplate String?  @map("message_template")
  category        String?  @db.VarChar(50)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  notificationLogs NotificationLog[]

  @@map("locations")
}

// 알림 쿨다운 관리 (30분 중복 방지)
model NotificationLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  sentAt     DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([userId, locationId, sentAt])
  @@map("notification_logs")
}

// 영상 원본 및 편집 결과
enum VideoKind {
  source
  result
}

model Video {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  kind            VideoKind @default(source)
  originalUrls    String[]  @default([]) @map("original_urls")
  originalS3Keys  String[]  @default([]) @map("original_s3_keys")
  editedUrl       String?   @map("edited_url")
  editedS3Key     String?   @map("edited_s3_key")
  thumbnailUrl    String?   @map("thumbnail_url")
  thumbnailS3Key  String?   @map("thumbnail_s3_key")
  durationSeconds Int?      @map("duration_seconds")
  stylePreset     String?   @map("style_preset") @db.VarChar(20)
  status          String    @default("pending") @db.VarChar(20)
  s3Key           String?   @map("s3_key")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  editJobs   EditJob[]
  snsUploads SnsUpload[]

  @@index([userId, createdAt])
  @@index([userId, kind, createdAt])
  @@map("videos")
}

// AI 편집 작업 상태 추적
model EditJob {
  id              String    @id @default(uuid()) @db.Uuid
  videoId         String    @map("video_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  pipelineVersion String    @default("2") @map("pipeline_version") @db.VarChar(20)
  editSpec        Json      @default("{}") @map("edit_spec")
  renderSpec      Json      @default("{}") @map("render_spec")
  status          String    @default("queued") @db.VarChar(20)
  progress        Int       @default(0)
  errorMessage    String?   @map("error_message")
  startedAt       DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("edit_jobs")
}

// SNS 연동 계정
model SnsConnection {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  platform         String    @db.VarChar(20)
  platformUserId   String?   @map("platform_user_id") @db.VarChar(100)
  platformUsername String?   @map("platform_username") @db.VarChar(100)
  accessToken      String?   @map("access_token")
  refreshToken     String?   @map("refresh_token")
  tokenExpiresAt   DateTime? @map("token_expires_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@map("sns_connections")
}

// SNS 업로드 이력
model SnsUpload {
  id             String    @id @default(uuid()) @db.Uuid
  videoId        String    @map("video_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  platform       String    @db.VarChar(20)
  platformPostId String?   @map("platform_post_id") @db.VarChar(100)
  status         String    @default("pending") @db.VarChar(20)
  /// 실패 시 플랫폼이 준 사유. 운영에서 업로드 실패를 추적할 유일한 단서다.
  errorMessage   String?   @map("error_message")
  uploadedAt     DateTime? @map("uploaded_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("sns_uploads")
}

// Stripe 구독 상태
model Subscription {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @unique @map("user_id") @db.Uuid
  plan                 String    @default("free") @db.VarChar(20)
  stripeCustomerId     String?   @map("stripe_customer_id") @db.VarChar(100)
  stripeSubscriptionId String?   @map("stripe_subscription_id") @db.VarChar(100)
  currentPeriodEnd     DateTime? @map("current_period_end") @db.Timestamptz(6)
  status               String    @default("active") @db.VarChar(20)
  /// 마지막으로 반영한 Stripe 이벤트의 생성 시각. 웹훅은 순서를 보장하지 않으므로
  /// 이보다 오래된 이벤트는 무시해 예전 상태로 되돌아가는 것을 막는다.
  lastStripeEventAt    DateTime? @map("last_stripe_event_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}
